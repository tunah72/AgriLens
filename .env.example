# ==============================================================================
# AgriLens — Environment Variables Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env before deploying:
#      cp .env.example .env
# 2. For AWS EC2 deployment, replace placeholder passwords and update
#    NEXT_PUBLIC_API_BASE_URL with your EC2 public IP or domain name.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Security
# ------------------------------------------------------------------------------
APP_ENV=production
# Generate a strong key: openssl rand -hex 32
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SKIP_DB_INIT=false

# ------------------------------------------------------------------------------
# 2. Model & Inference Serving (INT8 Quantized YOLO26-seg)
# ------------------------------------------------------------------------------
MODEL_PATH=/models/yolo26_quantized.onnx
CLASS_NAMES_PATH=/models/class_names.json
MODEL_INPUT_SIZE=1024
MODEL_VERSION=yolo26-seg-onnx

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=plant_disease
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme

# ------------------------------------------------------------------------------
# 4. Redis Cache & Sliding-Window Rate Limiting
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
RATE_LIMIT_PREDICT_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=10
KNOWLEDGE_CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 5. MinIO Object Storage (S3-Compatible)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=plant-disease-images
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# 6. MLflow Experiment Tracking Server
# ------------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000

# ------------------------------------------------------------------------------
# 7. Frontend Client (Next.js 15)
# ------------------------------------------------------------------------------
# For local development: http://localhost:8000/api/v1
# For AWS EC2 deployment: http://<EC2_PUBLIC_IP>:8000/api/v1 (or https://your-domain.com/api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
