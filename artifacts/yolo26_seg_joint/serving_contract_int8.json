{
  "model_name": "yolo26n_seg_joint_int8.onnx",
  "input": {
    "name": "images",
    "shape": [
      1,
      3,
      1024,
      1024
    ],
    "preprocess": "letterbox to square, pad 114, RGB, /255"
  },
  "outputs": [
    {
      "name": "output0",
