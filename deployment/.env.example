# Biến môi trường cho docker compose
# Copy file này thành .env và chỉnh sửa nếu cần

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme

# MinIO
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# Backend
SECRET_KEY=change-me-in-production

# Đường dẫn thư mục chứa model ONNX (không dùng path tiếng Việt)
# Windows: copy thư mục models/ sang C:\docker-models rồi set path này
# Linux/Mac: dùng đường dẫn tuyệt đối tới thư mục models/
MODELS_DIR=C:\docker-models
