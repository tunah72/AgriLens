# ==============================================================================
# AgriLens Deployment — Environment Variables Configuration (.env)
# ==============================================================================
# Copy this file to .env:
#   cp deployment/.env.example .env
# ==============================================================================

# Application & Security
APP_ENV=production
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SKIP_DB_INIT=false

# Model Configuration
MODEL_PATH=/models/yolo26_quantized.onnx
CLASS_NAMES_PATH=/models/class_names.json
MODEL_INPUT_SIZE=1024
MODEL_VERSION=yolo26-seg-onnx

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=plant_disease
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
RATE_LIMIT_PREDICT_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=10
KNOWLEDGE_CACHE_TTL_SECONDS=3600

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=plant-disease-images
MINIO_SECURE=false

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Frontend
# Replace localhost with EC2 public IP or domain name when deploying on AWS EC2
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
